import {
  "wzzc-dev/moui",
  "wzzc-dev/moui/views",
  "wzzc-dev/moui/runtime",
  "wzzc-dev/moui/backend/linux" @platform_host,
  "wzzc-dev/moui_skia_renderer" @render_skia,
}

supported_targets = "native"

pkgtype(kind: "executable")

options(
  link: { "native": { "cc-link-flags": "" } },
  targets: { "main.mbt": [ "native" ] },
)
